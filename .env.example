# Real backend URL — used by Vite proxy (server-side, bypasses SSL cert issues)
VITE_API_BASE_URL=https://localhost:51799/

# Axios base URL — use relative path so browser calls go through the Vite proxy
VITE_API_CLIENT_BASE_URL=/

# Tenant code fallback for local development (no subdomain on localhost)
VITE_TENANT_CODE=dev

# App ID — identifies this app to the API (same value across all environments)
VITE_APP_ID=REPLACE_WITH_APP_ID
